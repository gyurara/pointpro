# =====================================================================
# PetChain Docker Compose 환경 변수 (EC2 + MySQL 컨테이너 배포 기준)
#
# 사용법:  cp .env.example .env  후 아래 값을 운영값으로 교체.
# .env 는 비밀값을 포함하므로 절대 Git 에 커밋하지 않는다 (.gitignore 처리됨).
#
# ⚠️ 같은 공개 주소를 기준으로 FRONTEND_URL / CORS_ALLOWED_ORIGINS /
#    *_REDIRECT_URI 가 모두 일치해야 한다. EC2 라면 도메인 또는
#    퍼블릭 IP(http://<EC2_PUBLIC_IP>) 를 사용한다.
# =====================================================================

# ── 배포 모드 ───────────────────────────────────
# 병원/보험사/admin 기본 계정은 프로파일과 무관하게 항상 시드된다.
# 비워두면 ddl-auto=update 로 스키마가 자동 생성된다 (가장 간단, 권장 시작점).
# prod 로 설정하면 JWT_SECRET/DB_PASSWORD 기본값 사용을 차단하고(보안) ddl-auto=validate 가
#   되므로, docker-compose.yml 의 mysql 에 schema.sql 자동 적재 주석을 함께 해제해야 한다.
SPRING_PROFILES_ACTIVE=

# ── 공개 진입점 ─────────────────────────────────
# Nginx 프론트엔드 호스트 포트. 80 이면 http://<주소> 로 접속.
APP_PORT=80
# OAuth 성공 후 돌아갈 공개 프론트엔드 origin (도메인 또는 EC2 퍼블릭 주소).
FRONTEND_URL=https://petchain.example.com
# 백엔드 CORS 허용 origin (쉼표 구분). 보통 공개 프론트엔드 origin 과 동일.
CORS_ALLOWED_ORIGINS=https://petchain.example.com

# ── MySQL (컨테이너) ────────────────────────────
# 컨테이너 MySQL 의 root 비밀번호. 반드시 강한 값으로 교체.
#   생성 예: openssl rand -base64 24
DB_NAME=petchain
DB_USERNAME=root
DB_PASSWORD=change-me-strong-db-password

# ── Spring Boot / 관리자 ────────────────────────
# 플랫폼 관리자 초기 로그인 정보. ADMIN_PASSWORD 는 반드시 교체.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# ── JWT ─────────────────────────────────────────
# HS256 은 256bit(32바이트) 이상 엔트로피 필요. 반드시 랜덤 값으로 교체.
#   생성 예: openssl rand -base64 48
# (미설정 시 compose 가 기동을 거부한다 — 코드 기본 시크릿으로 폴백되지 않게 하기 위함)
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── OAuth: Google ───────────────────────────────
# redirect URI 는 제공자 콘솔에 등록한 값과 정확히 일치해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://petchain.example.com/api/auth/oauth/google/callback

# ── OAuth: Naver ────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://petchain.example.com/api/auth/oauth/naver/callback

# ── OAuth: Kakao ────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://petchain.example.com/api/auth/oauth/kakao/callback

# ── 로컬 개발 스크립트 경로 ─────────────────────
# scripts/start-petchain.sh 에서 사용한다. 비워두면 레포 상대경로와
# $HOME/go/src/fabric-samples/test-network 를 기본값으로 사용한다.
# 팀원마다 경로가 다르면 .env 에서만 각자 오버라이드한다.
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=petchain
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=1234
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FABRIC_NETWORK_DIR=$HOME/go/src/fabric-samples/test-network
CHAINCODE_DIR=./chaincode/petchain
BACKEND_DIR=./be/backend
FRONTEND_DIR=./fe/petchain
CHAIN_CHANNEL=petchannel
CHAIN_CHAINCODE=petchain
CHAIN_MSP_ID=Org1MSP
CHAIN_PEER_ENDPOINT=localhost:7051
CHAIN_PEER_HOST_OVERRIDE=peer0.org1.example.com
CHAIN_TLS_CERT_PATH=$HOME/go/src/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
CHAIN_CERT_PATH=$HOME/go/src/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/User1@org1.example.com-cert.pem
CHAIN_KEY_DIR=$HOME/go/src/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/
